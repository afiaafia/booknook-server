import type { Book } from '../src/modules/books/book.types.js';
import {
  assertAtlasMongoUri,
  assertLoopbackMongoUri,
} from './seed-open-library.js';

const CATALOG_USER = {
  userId: 'system:openlibrary',
  name: 'Open Library Catalog',
  email: 'catalog@booknook.invalid',
};

type Category =
  | 'Fiction'
  | 'Romance'
  | 'Science'
  | 'History'
  | 'Kids'
  | 'Others';

type CuratedBook = {
  title: string;
  author: string;
  category: Category;
};

type SearchDoc = {
  key?: string;
  title?: string;
  author_name?: string[];
  cover_i?: number;
  first_publish_year?: number;
  subject?: string[];
};

type SearchResponse = {
  docs?: SearchDoc[];
};

type SeedBook = Omit<Book, '_id'>;

const CURATED_BOOKS: CuratedBook[] = [
  // Fiction
  { title: 'The Alchemist', author: 'Paulo Coelho', category: 'Fiction' },
  { title: 'The Kite Runner', author: 'Khaled Hosseini', category: 'Fiction' },
  { title: 'A Thousand Splendid Suns', author: 'Khaled Hosseini', category: 'Fiction' },
